     $log[] = 'Tables created (or already existed).';
 
+    // Columns added after the initial release aren't covered by CREATE TABLE
+    // IF NOT EXISTS on an existing database, so add them here if missing.
+    $addColumnIfMissing = function (string $table, string $column, string $definition) use ($pdo, &$log) {
+        $stmt = $pdo->prepare(
+            'SELECT COUNT(*) FROM information_schema.columns WHERE table_schema = DATABASE() AND table_name = ? AND column_name = ?'
+        );
+        $stmt->execute([$table, $column]);
+        if ((int)$stmt->fetchColumn() === 0) {
+            $pdo->exec("ALTER TABLE `$table` ADD COLUMN $definition");
+            $log[] = "Added column $table.$column.";
+        }
+    };
+    $addColumnIfMissing('users', 'last_login_at', 'last_login_at DATETIME NULL');
+    $addColumnIfMissing('recipes', 'category', 'category VARCHAR(60) NULL');
+    $addColumnIfMissing('recipes', 'status', "status VARCHAR(20) NOT NULL DEFAULT 'published'");
+    $addColumnIfMissing('recipes', 'updated_at', 'updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP');
