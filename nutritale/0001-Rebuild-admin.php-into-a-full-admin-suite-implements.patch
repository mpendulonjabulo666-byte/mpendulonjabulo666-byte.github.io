new file mode 100644
index 0000000..345ff3c
--- /dev/null
+++ b/nutritale/includes/admin_helpers.php
@@ -0,0 +1,151 @@
+<?php
+// Shared helpers for the admin suite (admin.php + includes/admin/*.php).
+require_once __DIR__ . '/functions.php';
+require_once __DIR__ . '/icons.php';
+
+// [page key, label, icon name] — order drives the sidebar.
+const ADMIN_NAV = [
+    ['dashboard', 'Dashboard', 'grid'],
+    ['recipes', 'Recipes', 'book'],
+    ['categories', 'Categories', 'layers'],
+    ['users', 'Users', 'users'],
+    ['reports', 'Reports', 'flag'],
+    ['mealplans', 'Meal plans', 'calendar'],
+    ['analytics', 'Analytics', 'chart'],
+    ['settings', 'Settings', 'settings'],
+    ['profile', 'Admin profile', 'user'],
+];
+
+const ADMIN_SETTINGS_DEFAULTS = [
+    'recipe_submissions' => '1',
+    'ai_recipe_matching' => '1',
+    'marketplace' => '1',
+    'maintenance_mode' => '0',
+    'notify_new_reports' => '1',
+    'notify_new_submissions' => '1',
+    'notify_weekly_analytics' => '1',
+];
+
+function admin_setting(string $key): bool
+{
+    static $rows = null;
+    if ($rows === null) {
+        $rows = db()->query('SELECT setting_key, setting_value FROM admin_settings')->fetchAll(PDO::FETCH_KEY_PAIR);
+    }
+    $value = $rows[$key] ?? (ADMIN_SETTINGS_DEFAULTS[$key] ?? '0');
+    return $value === '1';
+}
+
+function admin_set_setting(string $key, bool $on): void
+{
+    db()->prepare(
+        'INSERT INTO admin_settings (setting_key, setting_value) VALUES (?, ?)
+         ON DUPLICATE KEY UPDATE setting_value = VALUES(setting_value)'
+    )->execute([$key, $on ? '1' : '0']);
+}
+
+// Small rounded status pill, used across every admin table.
+function admin_pill(string $text, string $tone = 'gray'): string
+{
+    $tones = [
+        'green' => ['bg' => '#eef6ea', 'bd' => 'rgba(47,107,69,0.3)', 'fg' => '#2a6340'],
+        'gold' => ['bg' => '#fbf4e2', 'bd' => 'rgba(201,162,39,0.45)', 'fg' => '#7d6620'],
+        'gray' => ['bg' => '#eef1ee', 'bd' => 'rgba(31,61,43,0.14)', 'fg' => '#5b6b61'],
+    ];
+    $t = $tones[$tone] ?? $tones['gray'];
+    return '<span style="display:inline-block;padding:6px 12px;border-radius:999px;background:' . $t['bg']
+        . ';border:1px solid ' . $t['bd'] . ';color:' . $t['fg'] . ';font-size:11.5px;font-weight:700;white-space:nowrap;">'
+        . h($text) . '</span>';
+}
+
+// Real on/off switch — posts back to the current admin page.
+function admin_toggle_switch(string $name, bool $on): string
+{
+    $csrf = h(csrf_token());
+    $checked = $on ? 'true' : 'false';
+    $bg = $on ? '#1f3d2b' : '#e4e9e5';
+    $bd = $on ? 'rgba(201,162,39,0.55)' : 'rgba(31,61,43,0.16)';
+    $knobBg = $on ? '#f3e2b0' : '#fff';
+    $knobLeft = $on ? '25' : '3';
+    return '<form method="post" style="margin:0;">'
+        . '<input type="hidden" name="csrf_token" value="' . $csrf . '">'
+        . '<input type="hidden" name="action" value="toggle_setting">'
+        . '<input type="hidden" name="key" value="' . h($name) . '">'
+        . '<button type="submit" role="switch" aria-checked="' . $checked . '" aria-label="' . h($name) . '" style="position:relative;width:52px;height:30px;flex:none;padding:0;cursor:pointer;border-radius:999px;border:1px solid ' . $bd . ';background:' . $bg . ';">'
+        . '<span style="position:absolute;top:3px;left:' . $knobLeft . 'px;width:22px;height:22px;border-radius:50%;background:' . $knobBg . ';box-shadow:0 1px 3px rgba(20,40,28,0.3);"></span>'
+        . '</button></form>';
+}
+
+// SVG line + area chart, ported 1:1 from the mockup's React lineChart().
+function admin_line_chart(array $points, string $label): string
+{
+    if (!$points) {
+        return '<p style="margin:0;font-size:13px;color:#6f8377;">Not enough data yet.</p>';
+    }
+    $w = 620;
+    $h = 200;
+    $max = max($points);
+    $min = min($points);
+    $range = ($max - $min) ?: 1;
+    $n = count($points);
+    $x = fn($i) => $n > 1 ? ($i / ($n - 1)) * $w : $w / 2;
+    $y = fn($v) => $h - (($v - $min) / $range) * ($h - 28) - 14;
+
+    $line = '';
+    foreach ($points as $i => $v) {
+        $line .= ($i ? 'L' : 'M') . number_format($x($i), 1, '.', '') . ' ' . number_format($y($v), 1, '.', '') . ' ';
+    }
+    $line = trim($line);
+    $area = $line . ' L' . $w . ' ' . $h . ' L0 ' . $h . ' Z';
+    $lastX = number_format($x($n - 1), 1, '.', '');
+    $lastY = number_format($y($points[$n - 1]), 1, '.', '');
+
+    $gridLines = '';
+    foreach ([0.25, 0.5, 0.75] as $g) {
+        $gy = $h * $g;
+        $gridLines .= '<line x1="0" x2="' . $w . '" y1="' . $gy . '" y2="' . $gy . '" stroke="#e8eee9" stroke-width="1"></line>';
+    }
+
+    return '<svg viewBox="0 0 ' . $w . ' ' . $h . '" width="100%" height="200" role="img" aria-label="' . h($label)
+        . '" preserveAspectRatio="none" style="display:block;overflow:visible;">'
+        . '<defs><linearGradient id="ntFill" x1="0" y1="0" x2="0" y2="1">'
+        . '<stop offset="0%" stop-color="#2f6b45" stop-opacity="0.28"></stop>'
+        . '<stop offset="100%" stop-color="#2f6b45" stop-opacity="0"></stop>'
+        . '</linearGradient></defs>'
+        . $gridLines
+        . '<path d="' . h($area) . '" fill="url(#ntFill)"></path>'
+        . '<path d="' . h($line) . '" fill="none" stroke="#2f6b45" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>'
+        . '<circle cx="' . $lastX . '" cy="' . $lastY . '" r="5" fill="#c9a227" stroke="#fff" stroke-width="2"></circle>'
+        . '</svg>';
+}
+
+// A small rotating set of category glyphs so category cards aren't all identical.
+function admin_category_icon(string $category): string
+{
+    $set = ['cup', 'pasta', 'droplet', 'bowl', 'plate', 'leaf-bowl'];
+    $index = abs(crc32($category)) % count($set);
+    return icon($set[$index], 26);
+}
+
+function admin_initials(string $name): string
+{
+    $parts = preg_split('/\s+/', trim($name));
+    $parts = array_filter($parts);
+    if (!$parts) return '?';
+    $first = mb_substr(reset($parts), 0, 1);
+    $last = count($parts) > 1 ? mb_substr(end($parts), 0, 1) : '';
+    return mb_strtoupper($first . $last);
+}
+
+// "Today" / "Yesterday" / "N days ago" / a formatted date further back.
+function admin_relative_date(?string $datetime): string
+{
+    if (!$datetime) return 'Never';
+    $then = new DateTime($datetime);
+    $today = new DateTime('today');
+    $diff = (int)$today->diff($then)->format('%r%a');
+    if ($diff === 0) return 'Today';
+    if ($diff === -1) return 'Yesterday';
+    if ($diff < 0 && $diff > -7) return abs($diff) . ' days ago';
+    return $then->format('M j, Y');
+}
