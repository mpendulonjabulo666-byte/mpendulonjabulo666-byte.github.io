diff --git a/nutritale/assets/js/admin-sidebar.js b/nutritale/assets/js/admin-sidebar.js
new file mode 100644
index 0000000..1d80050
--- /dev/null
+++ b/nutritale/assets/js/admin-sidebar.js
@@ -0,0 +1,28 @@
+(function () {
+    var KEY = 'nutritale-admin-sidebar-collapsed';
+    try {
+        if (localStorage.getItem(KEY) === '1') {
+            document.documentElement.setAttribute('data-admin-collapsed', '1');
+        }
+    } catch (e) {
+        // localStorage unavailable (private mode etc) - default to expanded.
+    }
+
+    document.addEventListener('DOMContentLoaded', function () {
+        var btn = document.getElementById('admin-sidebar-toggle');
+        if (!btn) return;
+        btn.addEventListener('click', function () {
+            var collapsed = document.documentElement.getAttribute('data-admin-collapsed') === '1';
+            if (collapsed) {
+                document.documentElement.removeAttribute('data-admin-collapsed');
+            } else {
+                document.documentElement.setAttribute('data-admin-collapsed', '1');
+            }
+            try {
+                localStorage.setItem(KEY, collapsed ? '0' : '1');
+            } catch (e) {
+                // ignore
+            }
+        });
+    });
+})();
