+<?php
+/** @var string $searchQuery Set by admin.php. */
+
+$categoryFilter = trim($_GET['category'] ?? '');
+$statusFilter = trim($_GET['status'] ?? '');
+
+$where = [];
+$params = [];
+if ($searchQuery !== '') {
+    $where[] = 'r.title LIKE ?';
+    $params[] = '%' . $searchQuery . '%';
+}
+if ($categoryFilter === 'uncategorized') {
+    $where[] = "(r.category IS NULL OR r.category = '')";
+} elseif ($categoryFilter !== '') {
+    $where[] = 'r.category = ?';
+    $params[] = $categoryFilter;
+}
+if ($statusFilter === 'uncategorized') {
+    $where[] = "(r.category IS NULL OR r.category = '')";
+} elseif (in_array($statusFilter, ['published', 'hidden'], true)) {
+    $where[] = 'r.status = ?';
+    $params[] = $statusFilter;
+}
+$whereSql = $where ? ('WHERE ' . implode(' AND ', $where)) : '';
+
+$stmt = db()->prepare(
+    "SELECT r.id, r.title, r.category, r.status, r.updated_at, r.created_at, r.is_generated,
+            COALESCE(u.name, 'NutriTale') AS author_name
+     FROM recipes r LEFT JOIN users u ON u.id = r.created_by
+     $whereSql
+     ORDER BY COALESCE(r.updated_at, r.created_at) DESC
+     LIMIT 500"
+);
+$stmt->execute($params);
+$recipes = $stmt->fetchAll();
+
+$totalRecipes = (int) db()->query('SELECT COUNT(*) FROM recipes')->fetchColumn();
+$totalCategories = (int) db()->query("SELECT COUNT(DISTINCT category) FROM recipes WHERE category IS NOT NULL AND category != ''")->fetchColumn();
