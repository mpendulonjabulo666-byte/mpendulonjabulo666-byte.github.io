# NutriTale — deny direct web access to files and folders that are only
# ever read from disk by PHP (require_once/file_get_contents), never
# requested as a URL. Harmless if PHP-FPM/nginx is used instead (see
# DEPLOYMENT.md Path B) — this file simply won't be read.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|sql|scripts|data)/ - [F,L]
    # /sitemap.xml is generated by sitemap.php (app_base_url() derives the
    # real domain at request time, so this needs no edit after deployment).
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

<FilesMatch "(\.sql|\.md|\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^manifest\.json$">
    <IfModule mod_mime.c>
        ForceType application/manifest+json
    </IfModule>
</FilesMatch>

# Self-hosted fonts (assets/fonts/). Older Apache mime.types files have no
# entry for .woff2, and a font served as text/plain or octet-stream is
# refused by some browsers - the page would fall back to system fonts.
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
</IfModule>

# The service worker and manifest must never be served stale: the live host
# was sending sw.js with "max-age=2592000" (30 days), and an installed app
# only picks up a new version when the browser sees a changed sw.js.
# (theme-toggle.js also registers with updateViaCache:'none' for browsers
# that would otherwise honour that header.) Assets stay cacheable - they
# are versioned by ?v= in every page.
<FilesMatch "^(sw\.js|manifest\.json)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, must-revalidate"
    </IfModule>
</FilesMatch>

# Browser safety headers for every response.
#   nosniff         - a file is only ever treated as the type the server says
#   SAMEORIGIN      - no other website can show NutriTale inside a frame
#                     (stops "clickjacking": a fake page over a real button)
#   Referrer-Policy - other sites see only "nutritale.freedev.app", never the
#                     full address of the page someone came from
#   HSTS            - once a browser has visited over HTTPS it refuses plain
#                     HTTP for a year. Browsers ignore this header on an HTTP
#                     response, so it can never lock anyone out of a non-HTTPS
#                     site.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Dotfiles (.git, .env, .htaccess itself, etc.) — never serve these.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
